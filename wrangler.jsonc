{
  // Cloudflare Workers deployment for SignalWard.
  //   Local:  npx wrangler dev
  //   Deploy: npx wrangler deploy
  //
  // The Worker runs in production mode and requires Supabase (Workers have no filesystem).
  // Set these as secrets (dashboard -> Settings -> Variables and Secrets, or `wrangler secret put`):
  //   SUPABASE_URL  SUPABASE_ANON_KEY  PUBLIC_URL
  //   SIGNALWARD_SESSION_SECRET  SIGNALWARD_INDICATOR_KEY  SIGNALWARD_SIGNING_KEY  SIGNALWARD_REPORT_ENCRYPTION_KEY
  //   optional: URLHAUS_AUTH_KEY  SIGNALWARD_URL_MODEL_B64  GEMINI_API_KEY
  //             URL model artifacts are generated from a licensed, labeled CSV with scripts/train_url_model.py.
  //   optional: GEMINI_API_KEY  GITHUB_TOKEN (fine-grained, public repositories read-only)
  //             SIGNALWARD_PREVIOUS_SIGNING_KEYS  SIGNALWARD_PREVIOUS_INDICATOR_KEYS
  //             SIGNALWARD_PREVIOUS_REPORT_ENCRYPTION_KEYS  SIGNALWARD_INDICATOR_KEY_VERSION
  "name": "signalward",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    "URL_INTEL": "on",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "ALLOW_SIGNUP": "true",
    "AUTH_PROVIDER": "supabase"
  }
}
