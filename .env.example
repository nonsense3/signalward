# SignalWard configuration. Copy to .env and fill in. Real environment variables override this file.
# Generate the SignalWard secrets with:  node apps/cli/signalward.ts keys
# Check the result with:                      node apps/cli/signalward.ts doctor

# ---------------------------------------------------------------- Server
NODE_ENV=development
HOST=127.0.0.1
# Leave empty to try 3000 and fall back to a free port.
PORT=
# Public origin used for auth email links and secure cookies. Required in production (https).
PUBLIC_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------- SignalWard secrets (required in production)
# 32+ random bytes, base64. Encrypts session cookies.
SIGNALWARD_SESSION_SECRET=
# Exactly 32 random bytes, base64. Master key for per-account HMAC indicator tags.
SIGNALWARD_INDICATOR_KEY=
# Version for the active indicator key; increment when rotating it.
SIGNALWARD_INDICATOR_KEY_VERSION=k1
# Optional base64url JSON history of up to three previous indicator keys. This contains secrets.
SIGNALWARD_PREVIOUS_INDICATOR_KEYS=
# Exactly 32 random bytes, base64. Encrypts stored scan reports at the application layer.
SIGNALWARD_REPORT_ENCRYPTION_KEY=
# Optional base64url JSON history of up to three previous report-encryption keys. This contains secrets.
SIGNALWARD_PREVIOUS_REPORT_ENCRYPTION_KEYS=
# Base64 PKCS#8 DER Ed25519 private key that signs evidence receipts.
SIGNALWARD_SIGNING_KEY=
# Optional base64url JSON public-key history from `node apps/cli/signalward.ts keys rotate`.
# Keep old public keys here so receipts created before rotation remain verifiable.
SIGNALWARD_PREVIOUS_SIGNING_KEYS=

# ---------------------------------------------------------------- Supabase (auth + database)
# Project settings -> API. Use the anon / publishable key only. Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# auto = Supabase when configured, otherwise local accounts under .signalward/
AUTH_PROVIDER=auto
ALLOW_SIGNUP=true

# ---------------------------------------------------------------- Gemini (server-side report summaries)
# Optional. Without a key, summaries come from the deterministic rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=7000

# ---------------------------------------------------------------- URL threat intelligence and trained URL model
# Optional URLhaus host reputation key. Only the hostname is sent; path and query are never sent.
URLHAUS_AUTH_KEY=
# Base64url encoding of the JSON artifact produced by scripts/train_url_model.py.
# Until a trained artifact and URLhaus key are configured, unlisted links remain inconclusive.
SIGNALWARD_URL_MODEL_B64=
# Optional Google Search grounding uses separate Google project quotas.
GEMINI_SEARCH_GROUNDING=false

# ---------------------------------------------------------------- Repository and link intelligence
# Domain-age lookups over RDAP for link scans (the link itself is never fetched). on | off
URL_INTEL=on
# Optional. Server-wide GitHub token used when a user scans without their own token. Public
# repositories download from the source archive first, which avoids the REST API's anonymous
# limit (60 requests/hour per IP); this token covers REST retries at 5,000 requests/hour.
# Create a fine-grained token with "Public repositories (read-only)" and no other permissions,
# so it can never expose a private repository to other users.
GITHUB_TOKEN=
